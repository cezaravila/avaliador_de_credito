# VARIAVEL QUE VAI APONTAR PARA O .YML DO PRODUÇÃO DO MS
SPRING_PROFILES_ACTIVE=production

# VARIAVEIS DE LOGIN PARA CRIAR O CONTAINER DO RABBITMQ
#E NOME DO CONTAINER E A PORTA DELE
SPRING_RABBITMQ_HOST=cursoms-container-rabbitmq
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=bootstrap
SPRING_RABBITMQ_PASSWORD=bootstrap

# VARIAVEIS DE LOGIN PARA CRIAR O CONTAINER DO KEYCLOAK
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

# VARIAVEIS PARA GERAR O BANCO DE DADOS
POSTGRES_DB=avaliador_credito
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin

# VARIAVEIS QUE MOSTRAM O CONTAINER E A PORTA DO KEYCLOAK
KEYCLOAK_SERVER=cursoms-container-keycloak
KEYCLOAK_PORT=8080

# URL PARA SER USADO NO .YML DE PRODUÇÃO, APONTANDO PARA O CONTAINER DO KEYCLOAK
SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=http://host.docker.internal:8081/realms/mscourserealm

# VARIAVEIS DE LOGIN DO EUREKA
EUREKA_SECURITY_USER_USERNAME=cursoms-eureka-user
EUREKA_SECURITY_USER_PASSWORD=ecok-pass-word-vai1

# NOME DO CONTAINER PARA INSERIR NO .YML DE PRODUÇÃO, APONTANDO PARA O EUREKA
SPRING_EUREKA_SERVER=cursoms-container-eureka

# VARIAVEIS PARA INSERIR NO MS QUE VAO GERAR AS TABELAS NO BANCO DE DADOS
POSTGRES_DATASOURCE_URL=jdbc:postgresql://postgres:5432/avaliador_credito
POSTGRES_DATASOURCE_USERNAME=postgres
POSTGRES_DATASOURCE_PASSWORD=admin